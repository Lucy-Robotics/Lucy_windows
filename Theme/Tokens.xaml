<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Lucy default preset — lucy_control_panel@mra/fix-theme src/Constants/theme.ts,
         derived tokens resolved with deriveSurfaceTokens(). Dark only, like the panel. -->

    <!-- Base palette -->
    <Color x:Key="MainColor">#141414</Color>
    <Color x:Key="SecondaryColor">#2B3E50</Color>
    <Color x:Key="HighlightColor">#00FF41</Color>
    <Color x:Key="TextColor">#F7F1E5</Color>

    <!-- Surfaces (75%) -->
    <Color x:Key="BgColor">#141414</Color>
    <Color x:Key="Surface1Color">#1C1C1C</Color>
    <Color x:Key="Surface2Color">#232323</Color>
    <Color x:Key="Surface3Color">#2E2E2E</Color>
    <Color x:Key="DeepColor">#0A0A0A</Color>

    <!-- Secondary (10%) — frames only -->
    <Color x:Key="LineColor">#732B3E50</Color>
    <Color x:Key="LineStrongColor">#2B3E50</Color>
    <Color x:Key="SecondaryHoverColor">#516476</Color>

    <!-- Highlight (15%) -->
    <Color x:Key="HighlightLightColor">#26FF67</Color>
    <Color x:Key="HighlightDarkColor">#00D91B</Color>
    <Color x:Key="HighlightSoftColor">#1A00FF41</Color>
    <Color x:Key="HighlightGlowSubtleColor">#1F00FF41</Color>
    <Color x:Key="HighlightGlowColor">#4000FF41</Color>
    <Color x:Key="HighlightGlowStrongColor">#8C00FF41</Color>

    <!-- Text -->
    <Color x:Key="TextSecondaryColor">#6C7D8E</Color>
    <Color x:Key="TextMutedColor">#52677F</Color>
    <Color x:Key="TextOnHighlightColor">#141414</Color>

    <!-- Status -->
    <Color x:Key="ErrorColor">#FF4343</Color>
    <Color x:Key="ErrorSoftColor">#24FF4343</Color>
    <Color x:Key="WarningColor">#FFAA00</Color>
    <Color x:Key="InfoColor">#00D8FF</Color>

    <!-- Grid background -->
    <Color x:Key="GridDotColor">#33F7F1E5</Color>
    <Color x:Key="GridLineColor">#17F7F1E5</Color>
    <SolidColorBrush x:Key="GridDotBrush" Color="{StaticResource GridDotColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface1GlassBrush" Color="#E61C1C1C" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHoverColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="HighlightLightBrush" Color="{StaticResource HighlightLightColor}" />
    <SolidColorBrush x:Key="HighlightDarkBrush" Color="{StaticResource HighlightDarkColor}" />
    <SolidColorBrush x:Key="HighlightSoftBrush" Color="{StaticResource HighlightSoftColor}" />
    <SolidColorBrush x:Key="HighlightGlowBrush" Color="{StaticResource HighlightGlowColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnHighlightBrush" Color="{StaticResource TextOnHighlightColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="ErrorFrameBrush" Color="#99FF4343" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#14FFAA00" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource HighlightGlowColor}" />

    <!-- Typography: IBM Plex Mono everywhere, Orbitron for the wordmark only -->
    <FontFamily x:Key="MonoFont">pack://application:,,,/Lucy;component/assets/fonts/#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Lucy;component/assets/fonts/#Orbitron</FontFamily>
    <sys:Double x:Key="FontXxs">10</sys:Double>
    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontWeb">16</sys:Double>
    <sys:Double x:Key="FontH4">20</sys:Double>
    <sys:Double x:Key="FontH3">24</sys:Double>
    <sys:Double x:Key="FontTitle">32</sys:Double>

    <!-- Chamfers -->
    <sys:Double x:Key="ChamferXs">4</sys:Double>
    <sys:Double x:Key="ChamferInput">5</sys:Double>
    <sys:Double x:Key="ChamferSm">6</sys:Double>
    <sys:Double x:Key="Chamfer">8</sys:Double>
    <sys:Double x:Key="ChamferMd">10</sys:Double>
    <sys:Double x:Key="ChamferLg">12</sys:Double>
    <sys:Double x:Key="ChamferModal">14</sys:Double>

    <!-- Motion: 0.14s, cubic-bezier(0.2,0.7,0.3,1) ≈ CubicEase EaseOut -->
    <Duration x:Key="MotionFast">0:0:0.14</Duration>
    <CubicEase x:Key="MotionEase" EasingMode="EaseOut" />

    <!-- Glows -->
    <DropShadowEffect x:Key="GlowSoft" Color="{StaticResource HighlightColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.3" />
    <DropShadowEffect x:Key="GlowLed" Color="{StaticResource HighlightColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="ShadowModal" Color="Black" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.6" />

    <!-- Page background: 48px dot grid with 8px dotted minor rules (.lucy-grid-bg) -->
    <DrawingBrush x:Key="GridBackgroundBrush" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Stretch="None"
                  Viewbox="0,0,48,48" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,48,48" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource GridLineBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="9,1" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="17,1" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="25,1" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="33,1" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="41,1" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="1,9" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="1,17" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="1,25" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="1,33" RadiusX="0.75" RadiusY="0.75" />
                            <EllipseGeometry Center="1,41" RadiusX="0.75" RadiusY="0.75" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource GridDotBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="1.2" RadiusY="1.2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>


</ResourceDictionary>
