<UserControl x:Class="Lucy.Views.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Lucy.Controls"
             xmlns:v="clr-namespace:Lucy.Views"
             xmlns:l="clr-namespace:Lucy.Launcher">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:IndentConverter x:Key="Indent" />

        <!-- Status LED: 8x8 square with glow (.status-led) -->
        <Style x:Key="Led" TargetType="Rectangle">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Fill" Value="{StaticResource HighlightBrush}" />
                    <Setter Property="Effect" Value="{StaticResource GlowLed}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Crashed">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Loading">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseLoading">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseLoading" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopping">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseStopping">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseStopping" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Loading">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopping">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Crashed">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A whole package row is the toggle target (Space in the TUI) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <c:ChamferBorder x:Name="Bd" Chamfer="{StaticResource ChamferSm}" Background="Transparent" BorderBrush="Transparent" Padding="10,8">
                            <ContentPresenter />
                        </c:ChamferBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PackageRow" DataType="{x:Type l:PackageItem}">
            <Button Style="{StaticResource RowButton}" Margin="{Binding IndentLevel, Converter={StaticResource Indent}}"
                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" IsEnabled="{Binding IsSupported}" ToolTip="{Binding UnsupportedReason}">
                <Grid x:Name="Row">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource TuiToggle}" IsChecked="{Binding Selected, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                              VerticalAlignment="Center" Width="74" />
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StageText}" FontSize="10" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding StageText, Converter={x:Static v:NonEmptyToVisibility.Instance}}" />
                        <Button Style="{StaticResource LinkButton}" Content="{Binding Url}" FontSize="11" HorizontalAlignment="Left" Margin="0,2,0,0"
                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}"
                                Visibility="{Binding ShowUrl, Converter={StaticResource BoolToVis}}" ToolTip="Open in the browser" />
                        <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource InfoBrush}"
                                   Visibility="{Binding Hint, Converter={x:Static v:NonEmptyToVisibility.Instance}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Led}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLabel}" Width="72" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Config.IsCore}" Value="True">
                    <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanEnable}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SessionHeader" DataType="{x:Type l:Session}">
            <StackPanel Orientation="Horizontal">
                <Rectangle x:Name="Led" Width="7" Height="7" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8" Style="{StaticResource GhostButton}" Padding="4" MinHeight="0"
                        Margin="6,0,-6,0" ToolTip="Close tab"
                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                    <Setter TargetName="Led" Property="Fill" Value="{StaticResource HighlightBrush}" />
                    <Setter TargetName="Led" Property="Effect" Value="{StaticResource GlowLed}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SessionContent" DataType="{x:Type l:Session}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold">
                            <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" /><Run Text="{Binding Title, Mode=OneWay}" />
                            <Run Text="  CONSOLE LOG" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding StateText, Mode=OneWay, StringFormat=[{0}]}" FontSize="11" Foreground="{StaticResource HighlightBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Command}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   ToolTip="{Binding Command}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Stop this process" Style="{StaticResource DangerButton}"
                            Command="{Binding DataContext.StopSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </Grid>
                <v:LogConsole Grid.Row="1" Buffer="{Binding Log}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: workspace + Lucy.py menu actions -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleText}" FontSize="22">
                    <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" /><Run Text="Lucy Control Center" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="WORKSPACE " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkButton}" Content="{Binding WorkspacePath}" FontSize="11" Command="{Binding OpenWorkspaceCommand}" ToolTip="Open the workspace folder" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding DevMode}" Content="Developer mode" Margin="0,0,18,0" VerticalAlignment="Center"
                          ToolTip="DEV=true in .env — nothing starts automatically; SSH remotes on update" />
                <Button Content="Update" Command="{Binding UpdateCommand}" Margin="0,0,8,0" ToolTip="git pull + install.py (repositories, pixi environment, build)" />
                <Button Content="Rebuild" Command="{Binding RebuildCommand}" Margin="0,0,8,0" ToolTip="pixi run build, then pixi run panel-install" />
                <Button Content="Logs" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}" ToolTip="Open Lucy's log folder" />
                <Button Content="Uninstall" Style="{StaticResource GhostButton}" Foreground="{StaticResource ErrorBrush}" Command="{Binding UninstallCommand}"
                        Margin="4,0,0,0" ToolTip="Stop everything and remove Lucy from this computer (optionally the workspace too)" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Package list -->
            <c:ChamferBorder Style="{StaticResource Card}" Padding="14,16">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Loaded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type v:PackageSection}">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource SectionLabel}" Margin="6,0,0,6">
                                            <Run Text="// " Foreground="{StaticResource HighlightBrush}" /><Run Text="{Binding Title, Mode=OneWay, Converter={x:Static v:UpperConverter.Instance}}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PackageRow}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" Margin="10" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Text="Could not load the launcher" />
                        <TextBlock Text="{Binding LoadError}" Style="{StaticResource MutedText}" Margin="0,8,0,14" />
                        <Button Content="Run Update" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </c:ChamferBorder>

            <!-- Sessions (tmux windows) -->
            <c:ChamferBorder Grid.Column="2" Style="{StaticResource Card}" Padding="16,12,16,16">
                <Grid>
                    <TabControl ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                                ItemTemplate="{StaticResource SessionHeader}" ContentTemplate="{StaticResource SessionContent}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Sessions.Count, Converter={x:Static v:ZeroToVisibility.Instance}}">
                        <TextBlock FontSize="13" FontWeight="Bold" HorizontalAlignment="Center">
                            <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />Nothing running
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center">
                            Turn packages ON on the left, then press APPLY.<LineBreak />Each process gets a log tab here.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </c:ChamferBorder>
        </Grid>

        <!-- Footer: status line + actions -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Message}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Unapplied changes — press APPLY" FontSize="12" Foreground="{StaticResource WarningBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasUnappliedChanges}" Value="True" />
                                        <Condition Binding="{Binding HasMessage}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Exit" Style="{StaticResource GhostButton}" Command="{Binding ExitCommand}" Margin="0,0,8,0" ToolTip="Stop all processes and exit" />
                <Button Content="Stop all" Style="{StaticResource DangerButton}" Command="{Binding StopAllCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" MinWidth="150" MinHeight="38">
                    <TextBlock Text="APPLY" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
