<UserControl x:Class="Lucy.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Lucy.Controls"
             xmlns:v="clr-namespace:Lucy.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="StepTemplate" DataType="{x:Type v:InstallStep}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="Led" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Led" Property="Fill" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="Led" Property="Effect" Value="{StaticResource GlowLed}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Led" Property="Fill" Value="{StaticResource HighlightBrush}" />
                    <Setter TargetName="Led" Property="Effect" Value="{StaticResource GlowLed}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter TargetName="Led" Property="Fill" Value="{StaticResource HighlightDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Led" Property="Fill" Value="{StaticResource ErrorBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30">
        <!-- ============================== Setup -->
        <Grid Visibility="{Binding IsSetup, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <Image Source="/Lucy;component/assets/logo.png" Width="96" Height="96" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,16" />
                <TextBlock Text="LUCY" Style="{StaticResource WordmarkText}" FontSize="50" />
                <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,28" FontSize="15">
                    Open-source ROS 2 framework to control and simulate robots, with a web control panel.
                </TextBlock>

                <TextBlock Style="{StaticResource SectionLabel}"><Run Text="// " Foreground="{StaticResource HighlightBrush}" />WHAT GETS INSTALLED</TextBlock>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" LineHeight="20">
                    <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />Git, Python 3 and pixi, if missing<LineBreak />
                    <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />MSVC Build Tools (C++ compiler), if missing<LineBreak />
                    <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />The lucy_ws workspace and its repositories<LineBreak />
                    <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />ROS 2 Jazzy (RoboStack) in a pixi environment<LineBreak />
                    <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />A Start Menu entry, then this window becomes the launcher
                </TextBlock>
                <Button Style="{StaticResource LinkButton}" Content="lucy-robotics.com/download" Command="{Binding OpenWebsiteCommand}"
                        HorizontalAlignment="Left" Margin="0,18,0,0" />
            </StackPanel>

            <c:ChamferBorder Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4">
                        <Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" /><Run Text="Install Lucy" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,22">Everything is installed for your user — no admin account needed.</TextBlock>

                    <TextBlock Style="{StaticResource SectionLabel}"><Run Text="// " Foreground="{StaticResource HighlightBrush}" />INSTALL FOLDER</TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding PathError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasPathError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding PathNote}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />

                    <CheckBox IsChecked="{Binding DeveloperMode}" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Developer mode" />
                            <TextBlock Text="SSH remotes for the repositories, manual launch (DEV=true in .env)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ShowAdvanced}" Margin="0,14,0,0" Content="Advanced: choose a branch" />
                    <Grid Margin="26,10,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" MaxDropDownHeight="260" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshBranchesCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Margin="0,28,0,0" HorizontalAlignment="Stretch" MinHeight="40">
                        <TextBlock Text="INSTALL" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </c:ChamferBorder>
        </Grid>

        <!-- ============================== Progress / done / failed -->
        <Grid Visibility="{Binding IsProgress, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <c:ChamferBorder Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"><Run Text="// " Foreground="{StaticResource HighlightBrush}" />STEPS</TextBlock>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Open log folder" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </c:ChamferBorder>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,14">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource HighlightBrush}"
                                   Text="{Binding Progress, StringFormat={}{0:0}%}" />
                    </Grid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" />
                </StackPanel>

                <v:LogConsole Grid.Row="1" Buffer="{Binding Log}" />

                <!-- failed -->
                <c:ChamferBorder Grid.Row="2" Margin="0,14,0,0" Chamfer="{StaticResource ChamferSm}" Background="{StaticResource ErrorSoftBrush}"
                                 BorderBrush="{StaticResource ErrorFrameBrush}" Padding="16,12"
                                 Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="Back" Command="{Binding BackCommand}" />
                            <Button Content="Retry" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </c:ChamferBorder>

                <!-- done -->
                <c:ChamferBorder Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Card}" ShowHud="True" Padding="18,14"
                                 BorderBrush="{StaticResource HighlightBrush}"
                                 Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="Bold"><Run Text="&gt; " Foreground="{StaticResource HighlightBrush}" />Lucy is installed</TextBlock>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">Find it in the Start Menu as "Lucy". This window now becomes the launcher.</TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding OpenLauncherCommand}" MinWidth="170" MinHeight="40">
                            <TextBlock Text="OPEN LAUNCHER" FontWeight="Bold" />
                        </Button>
                    </Grid>
                </c:ChamferBorder>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
