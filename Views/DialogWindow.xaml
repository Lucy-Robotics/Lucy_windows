<Window x:Class="Lucy.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Lucy.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="24">
        <c:ChamferBorder Style="{StaticResource Card}" Chamfer="{StaticResource ChamferModal}" ShowHud="True"
                         BorderBrush="{StaticResource LineStrongBrush}" Padding="24,20" Effect="{StaticResource ShadowModal}"
                         MinWidth="380" MaxWidth="560" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Rectangle x:Name="Tick" Width="3" Height="14" Fill="{StaticResource HighlightBrush}" Effect="{StaticResource GlowLed}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8" />
                <TextBlock x:Name="DetailText" Style="{StaticResource MutedText}" Margin="0,0,0,8" Visibility="Collapsed" />
                <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" />
            </StackPanel>
        </c:ChamferBorder>
    </Grid>
</Window>
